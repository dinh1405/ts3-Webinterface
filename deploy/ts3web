#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# ts3web – command-line helper for a TS3 Webinterface installation
#   ts3web [-s <service>] <command>
#
# Instances are described in /etc/ts3-webinterface/<service>.conf (written by install.sh).
# ---------------------------------------------------------------------------
set -euo pipefail

CONF_DIR="/etc/ts3-webinterface"
SERVICE="${TS3WEB_SERVICE:-ts3-webinterface}"
if [[ ${1:-} == -s ]]; then SERVICE=$2; shift 2; fi
CONF="$CONF_DIR/$SERVICE.conf"

usage() {
  cat <<EOF
ts3web – TS3 Webinterface helper (instance: $SERVICE)

  ts3web status                     Service, health, version, TeamSpeak connection
  ts3web start|stop|restart         Control the webinterface service (not the TeamSpeak server)
  ts3web logs [-n N]                Follow the service log (journalctl)
  ts3web update [--version x.y.z]   Update to the latest (or given) release
  ts3web rollback                   Switch back to the previous version (.previous)
  ts3web setup-token [--regenerate] Show the setup token (or create a new one)
  ts3web reset-admin <user> [pw]    Create an admin account or reset its password
  ts3web config                     Show .env (secrets masked) and config paths
  ts3web check                      Quick diagnosis (service, port, node, files)
  ts3web uninstall [--purge] [--yes] Remove this installation
  ts3web -s <service> <command>     Address another instance (parallel installations)
EOF
}

die() { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }
[[ $# -ge 1 ]] || { usage; exit 1; }
CMD=$1; shift

need_root() { [[ $EUID -eq 0 ]] || die "Please run as root (sudo ts3web $CMD)."; }
load_conf() {
  [[ -r $CONF ]] || die "Instance \"$SERVICE\" not found ($CONF missing). Installed instances: $(ls "$CONF_DIR" 2>/dev/null | sed 's/\.conf$//' | tr '\n' ' ')"
  # shellcheck disable=SC1090
  . "$CONF"
}
run_as() {
  local u=$1; shift
  local home; home=$(getent passwd "$u" | cut -d: -f6)
  if command -v runuser >/dev/null 2>&1; then runuser -u "$u" -- env HOME="$home" "$@"; else su -s /bin/bash "$u" -c "HOME='$home' $(printf '%q ' "$@")"; fi
}
env_value() { grep -E "^$1=" "$APP_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]' || true; }
port() { local p; p=$(env_value PORT); echo "${p:-${PORT:-8088}}"; }
health() { curl -fsS --max-time 5 "http://127.0.0.1:$(port)/api/health" 2>/dev/null || true; }

case $CMD in
  help|--help|-h) usage ;;

  status)
    load_conf
    echo "Instance : $SERVICE  ($APP_DIR, user $APP_USER)"
    echo "Version  : $(tr -d '[:space:]' < "$APP_DIR/VERSION" 2>/dev/null || echo '?')"
    echo "Service  : $(systemctl is-active "$SERVICE" 2>/dev/null || true) / $(systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
    h=$(health)
    if [[ -n $h ]]; then
      echo "Health   : ok  (port $(port))"
      echo "TeamSpeak: $(echo "$h" | grep -o '"ts3Connected":[a-z]*' | cut -d: -f2 | sed 's/true/connected/; s/false/not connected/')"
    else
      echo "Health   : NOT responding on port $(port)"
    fi
    ;;

  start|stop|restart)
    need_root; load_conf
    systemctl "$CMD" "$SERVICE"
    systemctl --no-pager --lines=3 status "$SERVICE" || true
    ;;

  logs)
    load_conf
    n=100
    if [[ ${1:-} == -n ]]; then n=$2; fi
    journalctl -u "$SERVICE" -n "$n" -f
    ;;

  update)
    need_root; load_conf
    ver=""
    while [[ $# -gt 0 ]]; do case $1 in --version) ver=$2; shift 2 ;; *) shift ;; esac; done
    tmp=$(mktemp -d /tmp/ts3web-update.XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    repo=${REPO:-dinh1405/ts3-Webinterface}
    if [[ -z $ver ]]; then
      ver=$(curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$repo/releases/latest" | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1 || true)
      [[ -n $ver ]] || die "Could not determine the latest version."
    fi
    ver=${ver#v}
    cur=$(tr -d '[:space:]' < "$APP_DIR/VERSION" 2>/dev/null || echo '?')
    echo "Installed: $cur  →  available: $ver"
    if [[ $cur == "$ver" ]]; then echo "Already up to date."; exit 0; fi
    url="https://github.com/$repo/releases/download/v$ver/ts3-webinterface-$ver.tar.gz"
    echo "Downloading $url"
    curl -fL --progress-bar -o "$tmp/pkg.tar.gz" "$url"
    if curl -fsSL -o "$tmp/pkg.sha256" "$url.sha256" 2>/dev/null; then
      [[ $(awk '{print $1}' "$tmp/pkg.sha256") == "$(sha256sum "$tmp/pkg.tar.gz" | awk '{print $1}')" ]] || die "SHA-256 mismatch"
      echo "SHA-256 verified"
    fi
    mkdir -p "$tmp/x" && tar -xzf "$tmp/pkg.tar.gz" -C "$tmp/x"
    src=$(find "$tmp/x" -maxdepth 1 -mindepth 1 -type d | head -1)
    # Run the installer of the NEW package in update mode
    bash "$src/deploy/install.sh" --update --dir "$APP_DIR" --user "$APP_USER" --service-name "$SERVICE" --repo "$repo" --lang "${LANG_CHOICE:-en}" --yes --from-file "$tmp/pkg.tar.gz"
    ;;

  rollback)
    need_root; load_conf
    [[ -d $APP_DIR/.previous/server ]] || die "No previous version in $APP_DIR/.previous"
    prev=$(tr -d '[:space:]' < "$APP_DIR/.previous/VERSION" 2>/dev/null || echo '?')
    echo "Rolling back to $prev …"
    systemctl stop "$SERVICE"
    mkdir -p "$APP_DIR/.rollback-tmp"
    for entry in server web deploy node_modules package.json package-lock.json VERSION README.md README.de.md CHANGELOG.md LICENSE SECURITY.md .env.example; do
      [[ -e $APP_DIR/$entry ]] && mv "$APP_DIR/$entry" "$APP_DIR/.rollback-tmp/"
      [[ -e $APP_DIR/.previous/$entry ]] && mv "$APP_DIR/.previous/$entry" "$APP_DIR/"
    done
    rm -rf "$APP_DIR/.previous"
    mv "$APP_DIR/.rollback-tmp" "$APP_DIR/.previous"
    chown -R "$APP_USER:$APP_USER" "$APP_DIR"
    systemctl start "$SERVICE"
    sleep 2
    [[ -n $(health) ]] && echo "Service is up (version $(tr -d '[:space:]' < "$APP_DIR/VERSION"))." || echo "Service not responding – check: journalctl -u $SERVICE -n 50"
    ;;

  setup-token)
    need_root; load_conf
    if [[ ${1:-} == --regenerate ]]; then
      rm -f "$APP_DIR/data/setup-token"
      systemctl restart "$SERVICE"
      sleep 3
    fi
    st=$(curl -fsS --max-time 5 "http://127.0.0.1:$(port)/api/auth/setup-status" 2>/dev/null || true)
    if echo "$st" | grep -q '"needsSetup":false'; then
      echo "Setup is already complete – no token needed. Sign in at http://<host>:$(port)/"
      exit 0
    fi
    [[ -s $APP_DIR/data/setup-token ]] || die "No setup token found (is the service running? journalctl -u $SERVICE)"
    tok=$(tr -d '[:space:]' < "$APP_DIR/data/setup-token")
    pub=$(env_value PUBLIC_URL); pub=${pub:-http://<host>:$(port)}
    echo "Setup token: $tok"
    echo "Wizard URL : $pub/setup#token=$tok"
    ;;

  reset-admin)
    need_root; load_conf
    user=${1:-}
    pw=${2:-}
    [[ -n $user ]] || die "Usage: ts3web reset-admin <username> [password]"
    if [[ -z $pw ]]; then
      read -r -s -p "New password (min. 8 characters): " pw < /dev/tty; echo
    fi
    [[ ${#pw} -ge 8 ]] || die "Password too short."
    run_as "$APP_USER" bash -c "cd '$APP_DIR' && ENV_FILE='$APP_DIR/.env' ADMIN_USERNAME='$user' ADMIN_PASSWORD='$pw' node server/scripts/create-admin.js --role admin"
    ;;

  config)
    load_conf
    echo "# $APP_DIR/.env"
    sed -E 's/^(JWT_SECRET|TS3_QUERY_PASSWORD|[A-Z_]*TOKEN[A-Z_]*|[A-Z_]*SECRET[A-Z_]*)=.+/\1=********/' "$APP_DIR/.env" 2>/dev/null || echo "(not readable – run as root)"
    echo
    echo "# Browser-managed configuration: $APP_DIR/data/config.json $( [[ -f $APP_DIR/data/config.json ]] && echo '(exists)' || echo '(not yet written)')"
    echo "# Unit: /etc/systemd/system/$SERVICE.service"
    ;;

  check)
    load_conf
    ok() { printf '  \033[32m✔\033[0m %s\n' "$*"; }
    bad() { printf '  \033[31m✘\033[0m %s\n' "$*"; }
    command -v node >/dev/null && ok "node $(node -v)" || bad "node missing"
    [[ -f $APP_DIR/server/index.js ]] && ok "program files in $APP_DIR (version $(tr -d '[:space:]' < "$APP_DIR/VERSION" 2>/dev/null || echo '?'))" || bad "server/index.js missing"
    [[ -d $APP_DIR/node_modules ]] && ok "node_modules present" || bad "node_modules missing (run: ts3web update)"
    [[ -f $APP_DIR/.env ]] && ok ".env present ($(stat -c '%a %U' "$APP_DIR/.env"))" || bad ".env missing"
    [[ -f /etc/systemd/system/$SERVICE.service ]] && ok "unit $SERVICE.service" || bad "unit missing"
    grep -q '^KillMode=process' "/etc/systemd/system/$SERVICE.service" 2>/dev/null && ok "KillMode=process (TeamSpeak survives webinterface restarts)" || bad "KillMode=process missing in unit"
    [[ $(systemctl is-active "$SERVICE" 2>/dev/null) == active ]] && ok "service active" || bad "service not active"
    [[ -n $(health) ]] && ok "health endpoint answers on port $(port)" || bad "no answer on port $(port)"
    [[ -s $APP_DIR/data/users.json ]] && ok "users.json present" || echo "  ○ no users yet (setup pending: ts3web setup-token)"
    command -v sqlite3 >/dev/null && ok "sqlite3 available (consistent backups)" || echo "  ○ sqlite3 missing (backups fall back to file copy)"
    ;;

  uninstall)
    need_root; load_conf
    extra=""
    for a in "$@"; do case $a in --purge|--yes|-y) extra="$extra $a" ;; esac; done
    # shellcheck disable=SC2086
    bash "$APP_DIR/deploy/install.sh" --uninstall --dir "$APP_DIR" --service-name "$SERVICE" --lang "${LANG_CHOICE:-en}" $extra
    ;;

  *) usage; exit 1 ;;
esac
