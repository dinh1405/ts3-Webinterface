# ---------------------------------------------------------------------------
# TS3 Webinterface – environment configuration
#
# Copy to .env and adjust. Only the "Web server" and "Security" sections are
# needed to start: everything under "TeamSpeak server" and "ServerQuery" can be
# configured in the browser (setup wizard / Settings → Connection & installation)
# and is then stored in data/config.json, which takes precedence over this file.
#
# Precedence: data/config.json  >  .env  >  built-in defaults
# ---------------------------------------------------------------------------

# --- Web server (env only) ----------------------------------------------------
# Address and port to listen on. Keep 127.0.0.1 behind a reverse proxy
# (nginx/Apache/Plesk); use 0.0.0.0 for direct access.
HOST=127.0.0.1
PORT=8088
# 1 if a reverse proxy sits in front (X-Forwarded-* headers are trusted)
TRUST_PROXY=1
# Public URL (invite links, default e-mail sender)
PUBLIC_URL=https://ts.example.org
# Sender for e-mail notifications (default: ts3@<domain of PUBLIC_URL>)
#MAIL_FROM=ts3@example.org

# Default interface language before/without the wizard: de | en
UI_LANGUAGE=en

# --- Security (env only) ------------------------------------------------------
# Random secret for session tokens, e.g. generated with:  openssl rand -hex 48
JWT_SECRET=
# Session lifetime in hours
SESSION_HOURS=12
# Login rate limit: max failed attempts per window (minutes)
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MIN=15

# --- Directories (env only) ---------------------------------------------------
# Users, settings, audit log, history, config.json (JSON files)
DATA_DIR=data
# Backups (ZIP) and snapshots
BACKUP_DIR=backups

# --- TeamSpeak server (can be set in the browser instead) ---------------------
# Installation directory of the TS3 server (contains ts3server, ts3server.ini, logs/, files/)
#TS3_DIR=/opt/teamspeak3-server_linux_amd64

# How is the process controlled?  script | systemd | docker | custom | none
#TS3_CONTROL_MODE=script
# script:  start script and extra arguments (exactly as the server was started before)
#          default: <TS3_DIR>/ts3server_startscript.sh and <TS3_DIR>/ts3server.pid
#TS3_START_SCRIPT=/path/to/ts3server_startscript.sh
#TS3_START_ARGS=inifile=ts3server.ini
#TS3_PID_FILE=/path/to/ts3server.pid
# systemd: unit name (may need TS3_USE_SUDO=1 plus a sudoers rule)
#TS3_SYSTEMD_UNIT=teamspeak3
# docker:  container name
#TS3_DOCKER_CONTAINER=teamspeak
# custom:  arbitrary shell commands
#TS3_CMD_START=
#TS3_CMD_STOP=
#TS3_CMD_RESTART=
#TS3_CMD_STATUS=
#TS3_USE_SUDO=0

# Log files and database (default: <TS3_DIR>/logs and <TS3_DIR>/ts3server.sqlitedb)
#TS3_LOG_DIR=/path/to/logs
#TS3_DB_FILE=/path/to/ts3server.sqlitedb
# sqlite3 binary for consistent backups (apt install sqlite3)
#SQLITE3_BIN=sqlite3

# --- ServerQuery (can be set in the browser instead) --------------------------
#TS3_QUERY_HOST=127.0.0.1
#TS3_QUERY_PORT=10011
# raw (port 10011) or ssh (port 10022)
#TS3_QUERY_PROTOCOL=raw
#TS3_QUERY_USER=serveradmin
#TS3_QUERY_PASSWORD=
#TS3_QUERY_NICKNAME=Webinterface
# Virtual server to manage: by voice port ...
#TS3_SERVER_PORT=9987
# ... or by server id (takes precedence when > 0)
#TS3_SERVER_ID=0
